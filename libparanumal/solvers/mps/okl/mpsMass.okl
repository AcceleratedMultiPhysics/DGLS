// smoothed Heaviside (1 inside, phi < 0) and its derivative magnitude, half width eps
dfloat mpsHeaviside(const dfloat p, const dfloat eps){
  if (p < -eps) return 1.0;
  if (p >  eps) return 0.0;
  return 0.5*(1.0 - p/eps - sin(M_PI*p/eps)/M_PI);
}

dfloat mpsDelta(const dfloat p, const dfloat eps){
  if (p < -eps || p > eps) return 0.0;
  return 0.5*(1.0 + cos(M_PI*p/eps))/eps;
}

// per element: V_e = sum wJ H(phi + s) and L_e = sum wJ delta(phi + s), where the shift s
// applies to band elements only (clipped values outside the band are left alone)
@kernel void mpsMassIntegrals(const dlong Nelements,
                              const dfloat eps,
                              const dfloat s,
                              @restrict const  int    *  elementLayer,
                              @restrict const  dfloat *  wJ,
                              @restrict const  dfloat *  phi,
                              @restrict dfloat *  VL){

  for(dlong e=0;e<Nelements;++e;@outer(0)){
    @shared dfloat s_V[p_Np];
    @shared dfloat s_L[p_Np];

    for(int n=0;n<p_Np;++n;@inner(0)){
      const dlong id = e*p_Np + n;
      const dfloat p = phi[id] + ((elementLayer[e] >= 0) ? s : 0.0);
      s_V[n] = wJ[id]*mpsHeaviside(p, eps);
      s_L[n] = wJ[id]*mpsDelta(p, eps);
    }

    for(int n=0;n<p_Np;++n;@inner(0)){
      if (n==0) {
        dfloat V = 0.0, Lsum = 0.0;
        for (int m=0;m<p_Np;++m) { V += s_V[m]; Lsum += s_L[m]; }
        VL[2*e+0] = V;
        VL[2*e+1] = Lsum;
      }
    }
  }
}

// phi += s on the band elements
@kernel void mpsMassShift(const dlong Nlist,
                          @restrict const  dlong  *  list,
                          const dfloat s,
                          @restrict dfloat *  phi){
  for(dlong l=0;l<Nlist;++l;@outer(0)){
    for(int n=0;n<p_Np;++n;@inner(0)){
      phi[list[l]*p_Np + n] += s;
    }
  }
}
