// low storage RK update restricted to a list of elements
@kernel void mpsLevelSetUpdate(const dlong Nlist,
                               @restrict const  dlong  *  list,
                               const dfloat dt,
                               const dfloat rka,
                               const dfloat rkb,
                               @restrict const  dfloat *  rhs,
                               @restrict dfloat *  res,
                               @restrict dfloat *  phi){

  for(dlong l=0;l<Nlist;++l;@outer(0)){
    for(int n=0;n<p_Np;++n;@inner(0)){
      const dlong id = list[l]*p_Np + n;

      dfloat r = dt*rhs[id];
      if (rka != 0.0) r += rka*res[id];

      res[id] = r;
      phi[id] += rkb*r;
    }
  }
}
