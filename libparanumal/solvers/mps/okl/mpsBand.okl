// flag band elements cut by the zero level set (sign change over the nodes)
@kernel void mpsBandCut(const dlong Nlist,
                        @restrict const  dlong  *  list,
                        @restrict const  dfloat *  phi,
                        @restrict int *  cut){

  for(dlong l=0;l<Nlist;++l;@outer(0)){

    @shared int s_flag[2]; // [0]: some phi <= 0, [1]: some phi >= 0

    for(int n=0;n<p_Np;++n;@inner(0)){
      if (n==0) { s_flag[0] = 0; s_flag[1] = 0; }
    }

    for(int n=0;n<p_Np;++n;@inner(0)){
      const dfloat p = phi[list[l]*p_Np + n];
      if (p <= 0.0) s_flag[0] = 1;
      if (p >= 0.0) s_flag[1] = 1;
    }

    for(int n=0;n<p_Np;++n;@inner(0)){
      if (n==0) cut[list[l]] = (s_flag[0] && s_flag[1]) ? 1 : 0;
    }
  }
}

// Velocity taper near the band edge (Peng et al. 1999, eq. 9):
//  c = 1 for |phi| <= beta, c = (|phi|-gamma)^2 (2|phi|+gamma-3beta)/(gamma-beta)^3
//  for beta < |phi| <= gamma, c = 0 beyond.
// The outermost layer is frozen (c = 0) regardless of |phi|: along a diagonal, J face
// layers are only ~J h/sqrt(2) away from the interface, and nothing may enter the band
// through its outer faces.
@kernel void mpsBandTaper(const dlong Nlist,
                          @restrict const  dlong  *  list,
                          const dfloat beta,
                          const dfloat gamma,
                          const int outerLayer,
                          @restrict const  int    *  elementLayer,
                          @restrict const  dfloat *  phi,
                          @restrict dfloat *  U){

  for(dlong l=0;l<Nlist;++l;@outer(0)){
    for(int n=0;n<p_Np;++n;@inner(0)){
      const dlong e = list[l];
      const dfloat a = fabs(phi[e*p_Np + n]);

      dfloat c = 1.0;
      if (a > gamma || elementLayer[e] >= outerLayer) {
        c = 0.0;
      } else if (a > beta) {
        const dfloat d = gamma - beta;
        c = (a-gamma)*(a-gamma)*(2.0*a + gamma - 3.0*beta)/(d*d*d);
      }

      const dlong vid = e*p_Np*p_NVfields + n;
      #pragma unroll p_NVfields
      for (int fld=0;fld<p_NVfields;++fld) U[vid + fld*p_Np] *= c;
    }
  }
}
