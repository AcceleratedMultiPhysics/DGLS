// Level set contact angle correction (CONTACT ANGLE MODEL LEVELSET).
// In band elements of layers L0, L1 with a wall face (bc 1, 4, 5), along every line of nodes that
// leaves the wall in the reference direction sigma (sigma = 0 at the wall, 2 at the opposite face):
//   grad phi at the wall node is rotated to grad phi* = |grad phi| ( -cos(theta) n_w + sin(theta) t ),
//   t the unit tangential direction of grad phi, n_w the outward wall normal, i.e. d phi*/dn_w = -|grad phi| cos(theta),
//   and phi_k += (a* - a) psi(sigma_k), a = x_sigma . grad phi, a* = x_sigma . grad phi*,
//   psi(sigma) = sigma (1 - sigma/2)^2  (psi(0) = 0, psi'(0) = 1, psi(2) = psi'(2) = 0).
// The wall value (contact point) is unchanged and the correction vanishes with its slope at the
// opposite face. One thread per element does the (few) wall lines serially.
@kernel void mpsContactAngleQuad2D(const dlong Nlist,
                                   @restrict const  dlong  *  list,
                                   @restrict const  int    *  elementLayer,
                                   @restrict const  int    *  EToB,
                                   @restrict const  dfloat *  vgeo,
                                   @restrict const  dfloat *  sgeo,
                                   @restrict const  dfloat *  D,
                                   @restrict const  dfloat *  gllz,
                                   const dfloat cosTheta,
                                   const dfloat sinTheta,
                                   @restrict dfloat *  phi){

  for(dlong l=0;l<Nlist;++l;@outer(0)){
    @shared dfloat s_p[p_Nq][p_Nq];
    const dlong e = list[l];

    for(int n=0;n<p_Np;++n;@inner(0)){
      s_p[n/p_Nq][n%p_Nq] = phi[e*p_Np + n];
    }

    for(int n=0;n<p_Np;++n;@inner(0)){
      if (n==0 && elementLayer[e] >= 0 && elementLayer[e] <= 1) {
        for (int f=0;f<p_Nfaces;++f) {
          const int bc = EToB[e*p_Nfaces+f];
          if (!(bc==1 || bc==4 || bc==5)) continue;
          for (int m=0;m<p_Nq;++m) {
            // wall node (i,j) and orientation of the inward line
            int iw, jw;
            if (f==0)      { iw = m;      jw = 0; }
            else if (f==1) { iw = p_Nq-1; jw = m; }
            else if (f==2) { iw = m;      jw = p_Nq-1; }
            else           { iw = 0;      jw = m; }
            const dlong gid = e*p_Np*p_Nvgeo + jw*p_Nq + iw;
            const dfloat rx = vgeo[gid + p_RXID*p_Np], ry = vgeo[gid + p_RYID*p_Np];
            const dfloat sx = vgeo[gid + p_SXID*p_Np], sy = vgeo[gid + p_SYID*p_Np];
            const dfloat J  = vgeo[gid + p_JID*p_Np];
            dfloat pr = 0.0, ps = 0.0;
            for (int k=0;k<p_Nq;++k) {
              pr += D[iw*p_Nq+k]*s_p[jw][k];
              ps += D[jw*p_Nq+k]*s_p[k][iw];
            }
            const dfloat gx = rx*pr + sx*ps, gy = ry*pr + sy*ps;
            const dfloat G = sqrt(gx*gx + gy*gy);
            if (G < 1e-14) continue;
            const dlong sk = e*p_Nfaces*p_Nfp + f*p_Nfp + m;
            const dfloat nx = sgeo[sk*p_Nsgeo+p_NXID], ny = sgeo[sk*p_Nsgeo+p_NYID];
            const dfloat gn = gx*nx + gy*ny;
            dfloat tx = gx - gn*nx, ty = gy - gn*ny;
            const dfloat gt = sqrt(tx*tx + ty*ty);
            if (gt > 1e-12*G) { tx /= gt; ty /= gt; } else { tx = -ny; ty = nx; }
            const dfloat gxs = G*(-cosTheta*nx + sinTheta*tx);
            const dfloat gys = G*(-cosTheta*ny + sinTheta*ty);
            // inward tangent x_sigma: x_r = J s_y, x_s = -J r_y, y_r = -J s_x, y_s = J r_x
            dfloat txs, tys;
            if (f==0)      { txs = -J*ry; tys =  J*rx; }     // sigma = 1 + s
            else if (f==2) { txs =  J*ry; tys = -J*rx; }     // sigma = 1 - s
            else if (f==3) { txs =  J*sy; tys = -J*sx; }     // sigma = 1 + r
            else           { txs = -J*sy; tys =  J*sx; }     // sigma = 1 - r
            const dfloat da = txs*(gxs - gx) + tys*(gys - gy);
            for (int k=0;k<p_Nq;++k) {
              const dfloat sig = (f==0 || f==3) ? 1.0 + gllz[k] : 1.0 - gllz[k];
              const dfloat psi = sig*(1.0 - 0.5*sig)*(1.0 - 0.5*sig);
              if (f==0 || f==2) s_p[k][iw] += da*psi;
              else              s_p[jw][k] += da*psi;
            }
          }
        }
      }
    }

    for(int n=0;n<p_Np;++n;@inner(0)){
      phi[e*p_Np + n] = s_p[n/p_Nq][n%p_Nq];
    }
  }
}
