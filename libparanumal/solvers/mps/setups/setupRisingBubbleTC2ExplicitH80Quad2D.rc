# Hysing et al. (2009) test case 2 on h=1/80 with the explicit viscous remainder: the same settings as the h=1/20 and h=1/40
# computations of setupRisingBubbleTC2Quad2D.rc (variable coefficient pressure with C0 pressure, filter 0.05, xi = 6,
# arithmetic density), only the mesh and a reduced time step differ: the skirts fail at t~1.96 with dt 1.25e-4 and at
# t~2.14 with dt 6.25e-5, so dt = 3.125e-5 (1/8 of the automatic step) is used. ~15 h to t=3 on a Quadro T2000.
# run: ./mpsMain setups/setupRisingBubbleTC2ExplicitH80Quad2D.rc > hysingTC2_h80.log
[FORMAT]
2.0

[DATA FILE]
data/mpsRisingBubbleTC22D.h

[MESH FILE]
meshes/hysing_h80.msh

[PRESSURE SOLVER]
VARIABLE

[MESH DIMENSION]
2

[ELEMENT TYPE] # number of edges
4

[BOX DIMX]
2

[BOX DIMY]
2

[BOX NX]
16

[BOX NY]
16

[BOX BOUNDARY FLAG]
1

[POLYNOMIAL DEGREE]
4

[THREAD MODEL]
CUDA

[PLATFORM NUMBER]
0

[DEVICE NUMBER]
0

[TWO PHASE FLOW]
TRUE

[LEVEL SET MOTION]
FLOW

[DENSITY INSIDE]
1.0

[DENSITY OUTSIDE]
1000.0

[VISCOSITY INSIDE]
0.1

[VISCOSITY OUTSIDE]
10.0

[GRAVITY Y]
-0.98

[TIME STEP]
3.125e-5

[FLOW ORDER]
2

[PRESSURE EXTRAPOLATION ORDER]
2

[START TIME]
0

[FINAL TIME]
3

[OUTPUT INTERVAL]
0.05

[OUTPUT TO FILE]
TRUE

[OUTPUT FILE NAME]
hysingTC2_h80

[REINITIALIZATION]
TRUE

[SUBCELL MARKING]
DETECTOR

[VELOCITY LINEAR SOLVER]
PCG

[VELOCITY DISCRETIZATION]
IPDG

[VELOCITY LINEAR SOLVER STOPPING CRITERION]
ABS/REL-INITRESID

[VELOCITY PRECONDITIONER]
JACOBI

[VELOCITY INITIAL GUESS STRATEGY]
EXTRAP

[VELOCITY INITIAL GUESS HISTORY SPACE DIMENSION]
9

[VELOCITY INITIAL GUESS EXTRAP DEGREE]
3

[VELOCITY INITIAL GUESS EXTRAP COEFFS METHOD]
MINNORM

[VELOCITY VERBOSE]
TRUE


[VELOCITY MULTIGRID COARSENING]
HALFDOFS

[VELOCITY MULTIGRID SMOOTHER]
CHEBYSHEV

[VELOCITY MULTIGRID CHEBYSHEV DEGREE]
2



[VELOCITY PARALMOND CYCLE]
KCYCLE

[VELOCITY PARALMOND SMOOTHER]
CHEBYSHEV

[VELOCITY PARALMOND CHEBYSHEV DEGREE]
2



[PRESSURE LINEAR SOLVER]
FPCG

[PRESSURE LINEAR SOLVER STOPPING CRITERION]
ABS/REL-INITRESID

[PRESSURE DISCRETIZATION]
CONTINUOUS

[PRESSURE PRECONDITIONER]
MULTIGRID

[PRESSURE INITIAL GUESS STRATEGY]
QR

[PRESSURE INITIAL GUESS HISTORY SPACE DIMENSION]
9

[PRESSURE INITIAL GUESS EXTRAP DEGREE]
3

[PRESSURE INITIAL GUESS EXTRAP COEFFS METHOD]
MINNORM

[PRESSURE VERBOSE]
TRUE


[PRESSURE MULTIGRID COARSENING]
HALFDOFS

[PRESSURE MULTIGRID SMOOTHER]
CHEBYSHEV

[PRESSURE MULTIGRID CHEBYSHEV DEGREE]
2



[PRESSURE PARALMOND CYCLE]
KCYCLE

[PRESSURE PARALMOND SMOOTHER]
CHEBYSHEV

[PRESSURE PARALMOND CHEBYSHEV DEGREE]
2




[SURFACE TENSION]
1.96

[CFL NUMBER]
0.5

[PRESSURE ITERATIONS]
1

[FLOW FILTER STRENGTH]
0.05

[PROPERTY THICKNESS]
6.0
