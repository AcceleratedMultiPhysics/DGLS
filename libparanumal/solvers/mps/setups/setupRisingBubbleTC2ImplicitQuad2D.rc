# Hysing et al. (2009) test case 2 on h=1/80 with implicit variable viscosity: rho 1000/1, mu 10/0.1, g 0.98, sigma 1.96
# (Re 35, Eo 125, density ratio 1000, viscosity ratio 100); variable coefficient pressure with C0 pressure, filter 0.05, xi = 6.
# The explicit viscous remainder fails in the thin skirts (h=1/80: t~1.96 at dt 1.25e-4, t~2.14 at 6.25e-5); with
# VISCOUS TREATMENT IMPLICIT the automatic time step (2.5e-4 on h=1/80, 5e-4 on h=1/40) is stable.
# Cost: ~20-26 FGMRES iterations per step (one nu0 velocity solve each); ~14 h to t=3 on a Quadro T2000.
# Velocity boundary data must be homogeneous (walls) for the implicit option.
# run: ./mpsMain setups/setupRisingBubbleTC2ImplicitQuad2D.rc > hysingTC2imp_h80.log
[FORMAT]
2.0

[DATA FILE]
data/mpsRisingBubbleTC22D.h

[MESH FILE]
meshes/hysing_h80.msh

[PRESSURE SOLVER]
VARIABLE

[MESH DIMENSION]
2

[ELEMENT TYPE] # number of edges
4

[BOX DIMX]
2

[BOX DIMY]
2

[BOX NX]
16

[BOX NY]
16

[BOX BOUNDARY FLAG]
1

[POLYNOMIAL DEGREE]
4

[THREAD MODEL]
CUDA

[PLATFORM NUMBER]
0

[DEVICE NUMBER]
0

[TWO PHASE FLOW]
TRUE

[LEVEL SET MOTION]
FLOW

[DENSITY INSIDE]
1.0

[DENSITY OUTSIDE]
1000.0

[VISCOSITY INSIDE]
0.1

[VISCOSITY OUTSIDE]
10.0

[GRAVITY Y]
-0.98

[TIME STEP]
0

[FLOW ORDER]
2

[PRESSURE EXTRAPOLATION ORDER]
2

[START TIME]
0

[FINAL TIME]
3

[OUTPUT INTERVAL]
0.05

[OUTPUT TO FILE]
TRUE

[OUTPUT FILE NAME]
hysingTC2imp_h80

[REINITIALIZATION]
TRUE

[SUBCELL MARKING]
DETECTOR

[VELOCITY LINEAR SOLVER]
PCG

[VELOCITY DISCRETIZATION]
IPDG

[VELOCITY LINEAR SOLVER STOPPING CRITERION]
ABS/REL-INITRESID

[VELOCITY PRECONDITIONER]
JACOBI

[VELOCITY INITIAL GUESS STRATEGY]
EXTRAP

[VELOCITY INITIAL GUESS HISTORY SPACE DIMENSION]
9

[VELOCITY INITIAL GUESS EXTRAP DEGREE]
3

[VELOCITY INITIAL GUESS EXTRAP COEFFS METHOD]
MINNORM

[VELOCITY VERBOSE]
TRUE


[VELOCITY MULTIGRID COARSENING]
HALFDOFS

[VELOCITY MULTIGRID SMOOTHER]
CHEBYSHEV

[VELOCITY MULTIGRID CHEBYSHEV DEGREE]
2



[VELOCITY PARALMOND CYCLE]
KCYCLE

[VELOCITY PARALMOND SMOOTHER]
CHEBYSHEV

[VELOCITY PARALMOND CHEBYSHEV DEGREE]
2



[PRESSURE LINEAR SOLVER]
FPCG

[PRESSURE LINEAR SOLVER STOPPING CRITERION]
ABS/REL-INITRESID

[PRESSURE DISCRETIZATION]
CONTINUOUS

[PRESSURE PRECONDITIONER]
MULTIGRID

[PRESSURE INITIAL GUESS STRATEGY]
QR

[PRESSURE INITIAL GUESS HISTORY SPACE DIMENSION]
9

[PRESSURE INITIAL GUESS EXTRAP DEGREE]
3

[PRESSURE INITIAL GUESS EXTRAP COEFFS METHOD]
MINNORM

[PRESSURE VERBOSE]
TRUE


[PRESSURE MULTIGRID COARSENING]
HALFDOFS

[PRESSURE MULTIGRID SMOOTHER]
CHEBYSHEV

[PRESSURE MULTIGRID CHEBYSHEV DEGREE]
2



[PRESSURE PARALMOND CYCLE]
KCYCLE

[PRESSURE PARALMOND SMOOTHER]
CHEBYSHEV

[PRESSURE PARALMOND CHEBYSHEV DEGREE]
2




[SURFACE TENSION]
1.96

[CFL NUMBER]
0.5

[PRESSURE ITERATIONS]
1

[FLOW FILTER STRENGTH]
0.05

[PROPERTY THICKNESS]
6.0

[VISCOUS TREATMENT]
IMPLICIT

[IMPLICIT VISCOUS TOLERANCE]
1e-6

[IMPLICIT VISCOUS MAX ITERATIONS]
30
