[OUTPUT TO FILE]
FALSE

[OUTPUT FILE NAME]
hydrostatic

[REINITIALIZATION]
FALSE

[SUBCELL MARKING]
NONE

[VELOCITY LINEAR SOLVER]
PCG

# can be IPDG, or CONTINUOUS
[VELOCITY DISCRETIZATION]
