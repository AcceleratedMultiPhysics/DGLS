# Sessile drop relaxing to a static contact angle on a slip wall (contact line benchmark)
[FORMAT]
2.0

[DATA FILE]
data/mpsSessileDrop2D.h

[MESH FILE]
meshes/drop_h16.msh

[MESH DIMENSION]
2

[ELEMENT TYPE] # number of edges
4

[BOX DIMX]
2

[BOX DIMY]
2

[BOX NX]
16

[BOX NY]
16

[BOX BOUNDARY FLAG]
1

[POLYNOMIAL DEGREE]
4

[THREAD MODEL]
CUDA

[PLATFORM NUMBER]
0

[DEVICE NUMBER]
0

[TWO PHASE FLOW]
TRUE

[LEVEL SET MOTION]
FLOW

[DENSITY INSIDE]
1.0

[DENSITY OUTSIDE]
0.1

[VISCOSITY INSIDE]
0.2

[VISCOSITY OUTSIDE]
0.02

[GRAVITY Y]
0.0

[TIME STEP]
0

[FLOW ORDER]
2

[PRESSURE EXTRAPOLATION ORDER]
2

[START TIME]
0

[FINAL TIME]
6

[OUTPUT INTERVAL]
0.1

[OUTPUT TO FILE]
FALSE

[OUTPUT FILE NAME]
drop

[REINITIALIZATION]
TRUE

[SUBCELL MARKING]
DETECTOR

[VELOCITY LINEAR SOLVER]
PCG

# can be IPDG, or CONTINUOUS
[VELOCITY DISCRETIZATION]
IPDG

[VELOCITY LINEAR SOLVER STOPPING CRITERION]
ABS/REL-INITRESID

# can be NONE, JACOBI, MASSMATRIX, PARALMOND, SEMFEM, MULTIGRID, or OAS
[VELOCITY PRECONDITIONER]
JACOBI

# can be LAST, ZERO, CLASSIC, QR, or EXTRAP
[VELOCITY INITIAL GUESS STRATEGY]
EXTRAP

[VELOCITY INITIAL GUESS HISTORY SPACE DIMENSION]
9

[VELOCITY INITIAL GUESS EXTRAP DEGREE]
3

[VELOCITY INITIAL GUESS EXTRAP COEFFS METHOD]
MINNORM

[VELOCITY VERBOSE]
TRUE

########## MULTIGRID Options ##############

# can be ALLDEGREES, HALFDEGREES, HALFDOFS
[VELOCITY MULTIGRID COARSENING]
HALFDOFS

# can be DAMPEDJACOBI or CHEBYSHEV
[VELOCITY MULTIGRID SMOOTHER]
CHEBYSHEV

# can be any integer >0
[VELOCITY MULTIGRID CHEBYSHEV DEGREE]
2

###########################################

########## ParAlmond Options ##############

# can be KCYCLE, or VCYCLE
# can add the EXACT and NONSYM option
[VELOCITY PARALMOND CYCLE]
KCYCLE

# can be DAMPEDJACOBI or CHEBYSHEV
[VELOCITY PARALMOND SMOOTHER]
CHEBYSHEV

# can be any integer >0
[VELOCITY PARALMOND CHEBYSHEV DEGREE]
2

###########################################

#################################################
########## Pressure Solver Options ##############
#################################################

# can be PCG, FPCG, NBPCG, NBFPCG, or PGMRES
[PRESSURE LINEAR SOLVER]
FPCG

[PRESSURE LINEAR SOLVER STOPPING CRITERION]
ABS/REL-INITRESID

# can be IPDG, or CONTINUOUS
[PRESSURE DISCRETIZATION]
IPDG

# can be NONE, JACOBI, MASSMATRIX, PARALMOND, SEMFEM, or MULTIGRID
[PRESSURE PRECONDITIONER]
MULTIGRID

# can be LAST, ZERO, CLASSIC, QR, or EXTRAP
[PRESSURE INITIAL GUESS STRATEGY]
QR

[PRESSURE INITIAL GUESS HISTORY SPACE DIMENSION]
9

[PRESSURE INITIAL GUESS EXTRAP DEGREE]
3

[PRESSURE INITIAL GUESS EXTRAP COEFFS METHOD]
MINNORM

[PRESSURE VERBOSE]
TRUE

########## MULTIGRID Options ##############

# can be ALLDEGREES, HALFDEGREES, HALFDOFS
[PRESSURE MULTIGRID COARSENING]
HALFDOFS

# can be DAMPEDJACOBI or CHEBYSHEV
[PRESSURE MULTIGRID SMOOTHER]
CHEBYSHEV

# can be any integer >0
[PRESSURE MULTIGRID CHEBYSHEV DEGREE]
2

###########################################

########## ParAlmond Options ##############

# can be KCYCLE, or VCYCLE
# can add the EXACT and NONSYM option
[PRESSURE PARALMOND CYCLE]
KCYCLE

# can be DAMPEDJACOBI or CHEBYSHEV
[PRESSURE PARALMOND SMOOTHER]
CHEBYSHEV

# can be any integer >0
[PRESSURE PARALMOND CHEBYSHEV DEGREE]
2

###########################################



[SURFACE TENSION]
1.0

# ---- contact line benchmark ----
# static contact angle (degrees, in the drop), imposed through the wall mirror of the LSQ curvature;
# the bottom wall is a slip wall (bc 5) so that the contact line can move
[CONTACT ANGLE]
60.0

[CURVATURE METHOD]
LSQ

[CURVATURE WALL MIRROR]
TRUE

[PRESSURE SOLVER]
SPLIT

[PRESSURE ITERATIONS]
1

[CFL NUMBER]
0.5

# local reinitialization near walls with the contact angle ghost condition
[WALL REINITIALIZATION]
TRUE
